# Local VFPU game-derived corpora — generated from private ELF inputs, never committed.
# tools/vfpu_words.txt was originally checked in but is excluded here because it was
# extracted from the private eboot.elf (446 words = exact distinct compute/prefix set
# from the game ELF).  Use tools/vfpu_synth_gen.py for the public synthetic corpus.
tools/vfpu_words.txt
tools/vfpu_words_local.txt
tools/vfpu_game_*.txt

# Raw reverse-engineering/decompiler exports (facts may be documented separately)
/docs/opengrip_ref/
/opengrip_ref/
/OpenGrip_For_Inspiration/
**/EBOOT.BIN.dec
**/EBOOT.BIN.dec.*

# Local third-party checkouts and redistributable runtime binaries
/third_party/

# Runtime state, logs, captures, and reports
/logs/
/fs/
/memstick/
*.log
*.ppm
# SR_TEXDUMP alpha-channel texture dumps. These are decoded retail game art;
# the matching .ppm colour dumps are already covered by the rule above.
# Never commit these.
tex_*.pgm
# SR_NIDLOG writes this into the working directory. It is the guest's verbatim
# syscall sequence for a retail title, so it is a runtime capture like the rest
# of this section -- never commit it.
nidseq_mine.txt
*.bin
*.psess
*.ngef
/progress.json
/visual_regression_report.json
/benchmarks_report.*
/watchpoints.json

