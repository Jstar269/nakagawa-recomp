{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "build/**",
    // Vendored upstream code (tracked, such as third_party/clay) and local
    // upstream checkouts (gitignored): not ours to reformat.
    "third_party/**",
    // Private, gitignored run evidence (/logs/). Game-derived and scratch
    // material that must never be reformatted or treated as project source.
    "logs/**",
    ".claude/worktrees/**",
    "**/.gemini/**",
    "docs/archive/**",
    ".github/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    // GitHub-rendered pages may centre a header and caption; nothing else needs raw HTML.
    "MD033": {
      "allowed_elements": ["div", "sub", "picture", "source", "img"]
    }
  }
}
