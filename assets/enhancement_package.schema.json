{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jstar269/nakagawa-recomp/raw/main/assets/enhancement_package.schema.json",
  "title": "Nakagawa Recomp Enhancement Package Declaration v1",
  "description": "Declaration for optional host enhancement or mod packages layered above authentic execution. Raw commercial guest addresses, proprietary game bytes, and untrusted scripts are strictly forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "version",
    "category",
    "target_title_id",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Schema version for the enhancement package declaration (must be 1)."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Unique machine-readable package identifier."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Human-readable name of the enhancement package."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of the package."
    },
    "category": {
      "type": "string",
      "enum": [
        "asset_replacement",
        "presentation_only",
        "guest_memory_code_hook",
        "save_data_modification",
        "camera_projection_override",
        "timing_frame_presentation"
      ],
      "description": "Enhancement category defining its observation and mutation boundary."
    },
    "target_title_id": {
      "type": "string",
      "pattern": "^([a-zA-Z0-9][a-zA-Z0-9._-]{0,63}|\\*)$",
      "description": "Target title identifier or '*' for title-agnostic universal packages."
    },
    "min_runtime_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Minimum required Nakagawa runtime semver."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$",
        "description": "Named symbolic capability requested by the package."
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "type"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,127}$",
            "description": "Symbolic name of the hook target; raw address literals (e.g. 0x...) are strictly forbidden."
          },
          "type": {
            "type": "string",
            "enum": [
              "pre_call",
              "post_call",
              "replace",
              "notify"
            ],
            "description": "Hook interception point relative to the target symbol."
          }
        }
      }
    },
    "game_version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,31}$",
      "description": "Target game release version string (e.g. '1.01') for timing rescale packages."
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 digest of the expected original guest executable."
    },
    "rng_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reason"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "rescale_probability",
            "subtick_30hz"
          ],
          "description": "Per-update RNG handling mode at rescaled logic rates."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Documented rationale for the chosen RNG policy."
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "function",
          "insn_offset",
          "stock_digest",
          "transform"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_.-]{0,63}$",
            "description": "Symbolic site identifier; raw address literals are forbidden."
          },
          "function": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,127}$",
            "description": "Symbolic function name; raw address literals and decompiler stems are forbidden."
          },
          "insn_offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536,
            "multipleOf": 4,
            "description": "Byte offset of the site's first instruction word from the function entry; a multiple of 4."
          },
          "stock_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase hex SHA-256 digest of the expected stock 32-bit instruction word(s)."
          },
          "word_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "default": 1,
            "description": "Number of contiguous 32-bit stock instruction words covered by stock_digest; only 1 has a defined rewrite today."
          },
          "transform": {
            "type": "string",
            "enum": [
              "count_x2",
              "step_x0.5",
              "decay_k_to_1-sqrt(1-k)",
              "probability_per_update_x0.5",
              "gate_30hz",
              "vblank_wait_2_to_1",
              "retention_m_to_sqrt(m)",
              "accel_x0.25",
              "launch_velocity_x0.5",
              "offset_x2",
              "window_start_x2"
            ],
            "description": "Declarative frame-rate rescale transform class."
          },
          "operand": {
            "type": "string",
            "enum": [
              "f64_high"
            ],
            "description": "What the site's lui builds when its encoding cannot say: f64_high is the upper word of a double (power-of-two scales only)."
          },
          "acceleration_site": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_.-]{0,63}$",
            "description": "launch_velocity_x0.5 only: the accel_x0.25 site of the per-update acceleration; that site must pin its whole float (word_count 2 or low_insn_offset)."
          },
          "low_insn_offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536,
            "multipleOf": 4,
            "description": "For a lone lui of a float: the offset of the ori that completes it, read (not rewritten) to know the whole value."
          },
          "low_stock_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the stock word at low_insn_offset."
          }
        }
      }
    },
    "update_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "insn_offset",
        "stock_digest"
      ],
      "description": "The instruction where one logic update begins; it must run exactly once per update. Gated sites run on alternate updates counted here, so a package with gated sites declares it.",
      "properties": {
        "function": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,127}$",
          "description": "Symbolic function name; raw address literals and decompiler stems are forbidden."
        },
        "insn_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536,
          "multipleOf": 4,
          "description": "Byte offset of the boundary instruction word from the function entry; a multiple of 4."
        },
        "stock_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex SHA-256 digest of the expected stock 32-bit instruction word."
        }
      }
    },
    "data_sites": {
      "type": "array",
      "minItems": 1,
      "description": "Constants in the executable's initialised data, rescaled once after the executable is loaded and before it runs, only while SR_EXPERIMENTAL_60HZ=1. The loaded bytes must equal the stock bytes or the run stops.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "symbol",
          "offset",
          "type",
          "stock_digest",
          "transform"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_.-]{0,63}$",
            "description": "Symbolic identifier; raw address literals are forbidden."
          },
          "symbol": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,127}$",
            "description": "Symbolic data label, resolved through the ELF symbols or the package's symbols sidecar."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576,
            "description": "Byte offset from the label; a multiple of the element size."
          },
          "type": {
            "type": "string",
            "enum": [
              "u8",
              "s8",
              "u16",
              "s16",
              "u32",
              "s32",
              "f32"
            ],
            "description": "Little-endian element type."
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "default": 1,
            "description": "Number of consecutive elements."
          },
          "stock_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase hex SHA-256 digest of the stock bytes of all elements."
          },
          "transform": {
            "type": "string",
            "enum": [
              "count_x2",
              "step_x0.5",
              "probability_per_update_x0.5",
              "decay_k_to_1-sqrt(1-k)",
              "retention_m_to_sqrt(m)",
              "accel_x0.25"
            ],
            "description": "Rescale applied to every element."
          }
        }
      }
    },
    "data_files": {
      "type": "array",
      "minItems": 1,
      "description": "Files the title reads from its disc, rewritten when the title opens them while SR_EXPERIMENTAL_60HZ=1. A file whose bytes do not match sha256 stops the run.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "format",
          "header_row",
          "first_data_row",
          "cells"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_.-]{0,63}$",
            "description": "Symbolic identifier; raw address literals are forbidden."
          },
          "path": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$",
            "description": "Path from the disc root, compared without case."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase hex SHA-256 digest of the stock file."
          },
          "format": {
            "type": "string",
            "enum": [
              "csv"
            ]
          },
          "header_row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Zero-based line holding the column names."
          },
          "first_data_row": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "description": "Zero-based first data line; it follows header_row."
          },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "column",
                "transform"
              ],
              "properties": {
                "column": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
                  "description": "ASCII column name from the header line."
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "description": "Zero-based data-row indexes; all data rows when left out."
                },
                "transform": {
                  "type": "string",
                  "enum": [
                    "count_x2",
                    "step_x0.5",
                    "probability_per_update_x0.5",
                    "decay_k_to_1-sqrt(1-k)",
                    "retention_m_to_sqrt(m)",
                    "accel_x0.25"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
