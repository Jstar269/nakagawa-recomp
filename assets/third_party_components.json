{
  "$schema": "./third_party_components.schema.json",
  "name": "nakagawa-recomp-third-party-components",
  "schema_version": 1,
  "description": "Single machine-readable source of truth for every third-party component that can enter a release artifact. tools/package_notices.py (native package), tools/generate_sbom.py (SBOM) and tools/test_third_party_notices.py (release gate) all read this file. A component without a spdx_id, a license text in the tree, and (for Python tools) a recorded license fails the gate.",
  "version_source_policy": "No version literal is trusted. Native DLL versions are read from the toolchain's own pacman database (var/lib/pacman/local/<pkg>/desc); Python and npm versions are read from the declared lockfiles. Every license text under third_party/licenses/ was copied verbatim from the component's own distribution in the local toolchain; each record below names the exact file it was copied from.",
  "native": {
    "copy_routes": [
      {
        "id": "compile-asset-copy",
        "file": "tools/copy_build_assets.ps1",
        "copies": [
          "SDL3.dll",
          "libgcc_s_seh-1.dll",
          "libwinpthread-1.dll",
          "libstdc++-6.dll"
        ],
        "note": "The three MinGW/UCRT runtime DLLs are copied only when a bundled .exe/.dll in the build directory actually imports them (objdump -p 'DLL Name' match). The conditional does not narrow the notice obligation: every DLL this route can copy must carry a license record."
      },
      {
        "id": "player-typography-runtime",
        "file": "tools/stage_runtime_dlls.py",
        "copies": [
          "SDL3.dll",
          "SDL3_ttf.dll",
          "libfreetype-6.dll",
          "libharfbuzz-0.dll",
          "libgraphite2.dll",
          "libglib-2.0-0.dll",
          "libintl-8.dll",
          "libiconv-2.dll",
          "libpcre2-8-0.dll",
          "libpng16-16.dll",
          "zlib1.dll",
          "libbz2-1.dll",
          "libbrotlidec.dll",
          "libbrotlicommon.dll",
          "libgcc_s_seh-1.dll",
          "libstdc++-6.dll",
          "libwinpthread-1.dll"
        ],
        "note": "Mechanical PE-import closure of SDL3.dll and SDL3_ttf.dll (objdump -p with the pure-Python PE fallback), recursively, stopping at Windows system DLLs; staged beside build/nakagawa_player.exe and into built packages (#421). The closure is resolved at staging time and fails closed on any unresolved non-system import; this list is the license obligation that follows it."
      }
    ],
    "host_resolved_dlls": [
      "vulkan-1.dll"
    ],
    "system_dll_patterns": [
      "^api-ms-win-.*\\.dll$",
      "^ext-ms-win-.*\\.dll$",
      "^(kernel32|kernelbase|user32|gdi32|shell32|ole32|oleaut32|advapi32|setupapi|imm32|version|winmm|comctl32|comdlg32|shlwapi|ws2_32|wsock32|dnsapi|iphlpapi|netapi32|userenv|uxtheme|dwmapi|d3d[0-9a-z_]*|dxgi|dinput[0-9a-z_]*|xinput[0-9a-z_]*|mfplat|mf|mfreadwrite|mfuuid|ntdll|msvcrt|ucrtbase|dwrite|rpcrt4|usp10)\\.dll$"
