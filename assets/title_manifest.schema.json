{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jstar269/nakagawa-recomp/raw/main/assets/title_manifest.schema.json",
  "title": "Nakagawa Recomp Public Title Manifest v1",
  "description": "Source-owned title configuration. Private paths, hashes, keys, analysis products, and game-derived evidence are intentionally out of scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "kind",
    "executable",
    "modules",
    "filesystem",
    "hle_profile",
    "feature_requirements",
    "verification_profile"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "enum": ["retail", "homebrew", "synthetic"]
    },
    "disc": {
      "$ref": "#/$defs/disc"
    },
    "executable": {
      "$ref": "#/$defs/executable"
    },
    "modules": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/module"}
    },
    "filesystem": {
      "$ref": "#/$defs/filesystem"
    },
    "hle_profile": {
      "$ref": "#/$defs/identifier"
    },
    "codegen_profile": {
      "enum": ["none", "hst"]
    },
    "feature_requirements": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "compatibility_manifest": {
      "$ref": "#/$defs/relativePath"
    },
    "verification_profile": {
      "$ref": "#/$defs/identifier"
    },
    "runtime_contract": {
      "$ref": "#/$defs/runtimeContract"
    },
    "profile_zero": {
      "$ref": "#/$defs/profileZero"
    },
    "notes": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "retail"}}, "required": ["kind"]},
      "then": {"required": ["disc"]},
      "else": {"not": {"required": ["disc"]}}
    },
    {
      "if": {"required": ["profile_zero"]},
      "then": {
        "required": ["kind", "runtime_contract"],
        "properties": {
          "kind": {"const": "synthetic"},
          "runtime_contract": {
            "type": "object",
            "required": ["profile_id"],
            "properties": {"profile_id": {"const": "profile-zero-v1"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "disc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "region", "revision_policy"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{4}[0-9]{5}$"
        },
        "region": {
          "enum": ["JP", "NA", "EU", "KR", "ASIA", "OTHER"]
        },
        "revision_policy": {
          "enum": ["exact-disc-id", "explicit-compatible-revisions"]
        },
        "compatible_revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{4}[0-9]{5}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"revision_policy": {"const": "exact-disc-id"}},
            "required": ["revision_policy"]
          },
          "then": {"not": {"required": ["compatible_revisions"]}},
          "else": {"required": ["compatible_revisions"]}
        }
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/uint32"},
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967296
        }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "entry", "bss_metadata_source", "extra_executable_spans"],
      "properties": {
        "base": {"$ref": "#/$defs/uint32"},
        "entry": {"$ref": "#/$defs/uint32"},
        "bss_metadata_source": {
          "enum": ["elf", "psp-header", "none"]
        },
        "extra_executable_spans": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/span"}
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "load_address", "required", "role"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "load_address": {"$ref": "#/$defs/uint32"},
        "required": {"type": "boolean"},
        "role": {
          "enum": ["guest-prx", "hle-capability", "optional-guest-prx"]
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_root", "memory_stick_root", "device_prefixes"],
      "properties": {
        "data_root": {"$ref": "#/$defs/relativePath"},
        "memory_stick_root": {"$ref": "#/$defs/relativePath"},
        "device_prefixes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}:$"
          }
        }
      }
    },
    "runtimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "core_contract", "profile_id", "capability_requirements",
        "unknown_capability_policy", "boot", "resources", "hle_overrides",
        "input_mapping", "enhancements", "evidence_profile"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "core_contract": {"const": "psp-core-v1"},
        "profile_id": {"$ref": "#/$defs/identifier"},
        "capability_requirements": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"enum": ["allegrex", "vfpu", "guest-memory", "scheduler", "interrupts", "callbacks", "generic-hle", "ge-display", "audio", "io", "backend-contracts", "evidence"]}
        },
        "unknown_capability_policy": {"const": "fail-closed"},
        "boot": {
          "type": "object", "additionalProperties": false,
          "required": ["entry_policy", "thread_policy", "arguments"],
          "properties": {
            "entry_policy": {"enum": ["image-entry", "manifest-entry"]},
            "thread_policy": {"enum": ["profile-default", "no-main-thread"]},
            "arguments": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 128}}
          }
        },
        "resources": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "locators"],
          "properties": {
            "mode": {"enum": ["none", "manifest-filesystem"]},
            "locators": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/relativePath"}}
          }
        },
        "hle_overrides": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["capability", "disposition", "reason", "evidence_class"],
            "properties": {
              "capability": {"$ref": "#/$defs/identifier"},
              "disposition": {"enum": ["core", "explicit-override", "unavailable"]},
              "reason": {"type": "string", "minLength": 1, "maxLength": 512},
              "evidence_class": {"enum": ["PSP_HARDWARE", "PRODUCTION_DISPATCH", "PRODUCTION_HELPER", "MODEL_REFERENCE", "HOST_DIFFERENTIAL", "SOURCE_SHAPE", "PRIVATE_TITLE_ACCEPTANCE"]}
            }
          }
        },
        "input_mapping": {
          "type": "object", "additionalProperties": false,
          "required": ["labels", "replay"],
          "properties": {
            "labels": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "replay": {"enum": ["none", "deterministic"]}
          }
        },
        "enhancements": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled_by_default", "capabilities"],
          "properties": {
            "enabled_by_default": {"type": "boolean"},
            "capabilities": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
          }
        },
        "evidence_profile": {"$ref": "#/$defs/identifier"}
      }
    },
    "profileZero": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "runnable", "source_program", "build", "acceptance"],
      "properties": {
        "schema_version": {"const": 1},
        "runnable": {"type": "boolean"},
        "source_program": {
          "type": "object", "additionalProperties": false,
          "required": ["source_files", "entry_symbol", "ownership"],
          "properties": {
            "source_files": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
            "entry_symbol": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "ownership": {"const": "project-authored-public"}
          }
        },
        "build": {
          "type": "object", "additionalProperties": false,
          "required": ["makefile", "working_directory", "target", "toolchain"],
          "properties": {
            "makefile": {"$ref": "#/$defs/relativePath"},
            "working_directory": {"$ref": "#/$defs/relativePath"},
            "target": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "toolchain": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!/)(?!.*\\\\)(?!.*:).+$"}
          }
        },
        "acceptance": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "status", "private_inputs_allowed", "cases"],
          "properties": {
            "schema_version": {"const": 1},
            "status": {"enum": ["scaffold", "ready", "blocked"]},
            "private_inputs_allowed": {"const": false},
            "cases": {
              "type": "array", "minItems": 1, "maxItems": 32,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "status", "evidence_class", "assertion"],
                "properties": {
                  "id": {"$ref": "#/$defs/identifier"},
                  "status": {"enum": ["planned", "implemented", "blocked"]},
                  "evidence_class": {"enum": ["PSP_HARDWARE", "PRODUCTION_DISPATCH", "PRODUCTION_HELPER", "MODEL_REFERENCE", "HOST_DIFFERENTIAL", "SOURCE_SHAPE", "PRIVATE_TITLE_ACCEPTANCE"]},
                  "assertion": {"type": "string", "minLength": 1, "maxLength": 512}
                }
              }
            }
          }
        }
      }
    }
  }
}
