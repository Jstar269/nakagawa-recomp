{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jstar269/nakagawa-recomp/schemas/third_party_components.schema.json",
  "title": "Nakagawa Recomp third-party component inventory",
  "description": "Machine-readable source of truth for every third-party component that can enter a release artifact. tools/test_third_party_notices.py fails closed when a recorded component lacks an SPDX identifier, a license text in the tree, or a recorded Python license.",
  "type": "object",
  "required": ["name", "schema_version", "native", "python_packages"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "version_source_policy": { "type": "string" },
    "native": {
      "type": "object",
      "required": ["copy_routes", "dlls"],
      "properties": {
        "copy_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file", "copies"],
            "properties": {
              "id": { "type": "string" },
              "file": { "type": "string" },
              "copies": { "type": "array", "items": { "type": "string" } },
              "note": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "host_resolved_dlls": { "type": "array", "items": { "type": "string" } },
        "system_dll_patterns": { "type": "array", "items": { "type": "string" } },
        "dlls": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/component" }
        },
        "linked_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "project_output": { "$ref": "#/$defs/component" },
        "host_resolved_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        }
      },
      "additionalProperties": true
    },
    "python_packages": {
      "type": "object",
      "required": ["lockfile", "packages"],
      "properties": {
        "lockfile": { "type": "string" },
        "note": { "type": "string" },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["version", "spdx_id", "recorded_from"],
            "properties": {
              "version": { "type": "string" },
              "spdx_id": { "type": "string" },
              "recorded_from": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "licenseText": {
      "type": "object",
      "required": ["file", "copied_from"],
      "properties": {
        "file": { "type": "string" },
        "copied_from": { "type": "string" },
        "sha256": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["name", "spdx_id", "license_texts"],
      "properties": {
        "name": { "type": "string" },
        "spdx_id": { "type": "string" },
        "dll": { "type": "string" },
        "id": { "type": "string" },
        "notice_file": { "type": "string" },
        "pacman_package": { "type": "string" },
        "upstream_origin": { "type": "string" },
        "upstream_revision": { "type": "string" },
        "disposition": { "type": "string" },
        "object_glob": { "type": "string" },
        "relink_doc": { "type": "string" },
        "note": { "type": "string" },
        "license_texts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/licenseText" } }
      },
      "additionalProperties": true
    }
  }
}
