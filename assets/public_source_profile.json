  "exclude_rationale": {
    "assets/titles/hst-ucus98701.json": "Title-specific manifest naming the retail product, disc identity, guest module addresses and private-route filesystem locations. Retain synthetic and generic title schemas; do not publish the HST configuration in the public candidate.",
    "docs/AUDIO_OUTPUT_ACCEPTANCE_20260807.md": "Acceptance evidence produced by running the retail title with private inputs and private save baselines. Game-run derived evidence is excluded from public scope.",
    "docs/DOCUMENTATION_AUDIT.md": "Internal documentation and publication audit record containing private-tree status, historical findings and legal-review work-product references. Recreate a public-facing documentation guide from the generic docs instead.",
    "docs/DUAL_REPO_SYNC.md": "Describes private repository topology and maintainer synchronisation procedures. Private repository relationships are excluded from public scope.",
    "docs/GHIDRA.md": "Reverse-engineering workflow for decrypted retail input and title-specific data. Excluded pending a generic, title-neutral rewrite.",
    "docs/HLE_CALL_CENSUS_2026-08-05.md": "Census measured by executing the retail title under private inputs. Game-run derived measurement evidence is excluded from public scope.",
    "docs/INVESTIGATION_CHECKPOINT_2026-07-18.md": "Private investigation checkpoint enumerating extracted retail structures, savedata layout and runtime observations. Excluded from public scope.",
    "docs/KEY_HISTORY_SCRUB.md": "Private archive sanitation runbook describing historical private content and rewrite operations. The public candidate carries only the generic history-audit tool and its public contract.",
    "docs/LEGAL_REWRITE_ASSESSMENT.md": "Internal legal-risk assessment and counsel-oriented source-comparison work product. It is not a public project guide and must not cross the publication boundary.",
    "docs/NID_INTEGRITY_AUDIT_2026-08-06.md": "Dated HST/NID investigation record containing historical issue-state and title-run context; the public candidate retains the source-owned manifest gate, not this work product.",
    "docs/NEXT_SESSION.md": "Private operational continuation notes containing local fixtures, inputs and maintainer instructions. Excluded from public scope.",
    "docs/PGD_AMCTRL_REVIEW_PACKET.md": "Qualified-review packet for the excluded PGD/amctrl implementation. Its source archaeology and distribution analysis remain outside the public candidate.",
    "docs/PGD_KEYS.md": "Operating instructions for local PSP constants and title version keys. Excluded with the PGD/amctrl implementation and tooling.",
    "docs/PGF_LICENSE_REVIEW_PACKET.md": "Qualified-review packet for the excluded PGF parser and replacement-font payloads. Its legal/source-comparison work product remains outside the public candidate.",
    "docs/PERFORMANCE.md": "Private title-run performance and renderer evidence containing route inputs, save identities, capture locations, game-derived fixture hashes and observed output measurements.",
    "docs/PHASE5_HARDWARE_EVIDENCE.md": "Dated hardware acceptance record retained for the private development lane; the public candidate does not ship historical acceptance narratives or run identifiers.",
    "docs/PSP_HARDWARE_FINDING_waitthreadend_20260805.md": "Dated hardware-finding record with private investigation context; the public candidate retains synthetic probe code and generic oracle guidance only.",
    "docs/PSP_HARDWARE_ORACLE.md": "Historical hardware-oracle operations and evidence record. It is not required to build the public source and is excluded to avoid publishing private run locations or stale acceptance claims.",
    "docs/PSP_ISSUE_MATRIX.json": "Generated historical issue snapshot with private-route readiness classifications and volatile tracker state; it is not a public API or build input.",
    "docs/PUBLISH_VS_EXCLUDE_MATRIX.md": "Internal publication disposition matrix containing historical topology and review-lane detail. The machine-readable profile is the only candidate policy authority.",
    "docs/PUBLICATION_LANE_VERIFICATION_2026-08-06.md": "Verification record for a private publication lane and historical repository reachability. Excluded from public scope.",
    "docs/RETAINED_BRANCH_AUDIT_2026-08-04.md": "Internal branch/topology audit naming private development branches and handoff dispositions. Excluded from public scope.",
    "docs/SAS_NID_SIGNATURES.md": "HST route-census and audio-handler disposition table. The public candidate retains source-owned SAS implementation/tests without title-run evidence.",
    "docs/STATUS_HISTORY.md": "Chronological engineering log containing title-run evidence, private save paths and game-derived identifiers. Excluded from public scope.",
    "docs/TEST_DISCOVERY.md": "Dated test-discovery report containing private-input-dependent counts and stale baseline claims; public contributors can use the live test command and focused tests.",
    "docs/TEST_MATRIX.json": "Generated test matrix containing private asset/key skip conditions and historical case metadata; it is not needed to run the public suite.",
    "docs/TEST_SHAPE_CLASSIFICATION.md": "Internal source-shape triage report tied to the historical generated test matrix; excluded from the public documentation surface.",
    "docs/TEST_SKIPS.md": "Private-input/key skip inventory naming title-specific save and key material; public security tests use synthetic fixtures and report unavailable private routes separately.",
    "docs/ROADMAP.md": "Historical strategic roadmap containing HST-specific product/topology decisions and stale references to excluded work products; not required for the public build.",
    "docs/provenance/INDEPENDENCE_BACKLOG.md": "Compact public index of provenance questions; detailed private measurements remain outside the candidate.",
    "docs/VFPU_ORACLE_BASELINE_2026-08-05.md": "Dated VFPU oracle investigation and hardware-result narrative; retain the independently checked VFPU data provenance, not this historical run record.",
    "docs/issue-139-face-resource-semantics.md": "Title-specific retail-image investigation with private route and address evidence; excluded pending a title-neutral rewrite.",
    "docs/issue-51-entry-semantics.md": "Title-specific continuation investigation containing retail-image address/role evidence and private regeneration claims; excluded from the generic public source.",
    "docs/provenance/IMPLEMENTATION_PROVENANCE.json": "Detailed development provenance ledger contains private investigation context, title-run and hardware-route references, and links to excluded legal/source-archaeology work products. The public candidate carries the path-hashed public ledger and concise independence model instead.",
    "docs/provenance/PGD_AMCTRL_SOURCE_ARCHAEOLOGY_2026-08-09.md": "Detailed source archaeology for the excluded PGD/amctrl implementation; qualified-review work product is not part of the public candidate.",
    "docs/provenance/PGF_SOURCE_ARCHAEOLOGY_2026-08-08.md": "Detailed source archaeology for the excluded PGF implementation and font lineage; qualified-review work product is not part of the public candidate.",
    "docs/provenance/SAL063_RETENTION_2026-08-06.md": "Private retention measurement and source-comparison worksheet. Keep the concise public notice, not the internal forensic worksheet.",
    "font/*.pgf": "Replacement PGF binaries byte-identical to PPSSPP assets/flash0/font at f0baf3ad. Byte provenance is verified; redistribution terms and required notices are not. Qualified review required before any public redistribution. See THIRD_PARTY_LICENSES/PPSSPP_FONTS.txt.",
    "src/rt/pgf.c": "PGF parser/rasterizer with recorded PPSSPP/JPCSP/intraFont lineage. Protectable-expression and downstream-licence effect are unresolved. Qualified review required. See docs/PGF_LICENSE_REVIEW_PACKET.md.",
    "src/rt/pgf.h": "Declarations for the lineage-sensitive PGF implementation. Excluded with its implementation.",
    "src/rt/audio.c": "Host audio backend is a materially modified sal063 derivative. It is excluded from the first public profile until the optional SDL audio backend receives a separately reviewed, public-safe replacement or release approval.",
    "src/rt/iso.c": "ISO/VFS implementation has a direct sal063 ancestor but is excluded from the first public profile while its extended implementation is separately reviewed for a generic release.",
    "THIRD_PARTY_LICENSES/PPSSPP_FONTS.txt": "Font redistribution evidence remains unresolved; exclude the packet with the optional PGF binaries rather than publish an unresolved rights question.",
    "src/rt/pgd.c": "PGD/amctrl interoperability implementation. Contains no key material and cannot operate without user-supplied constants, but distribution and anti-circumvention treatment are unresolved. Qualified review required; its review packet is excluded from the public candidate.",
    "src/rt/pgd.h": "Declarations for the PGD/amctrl implementation. Excluded with its implementation.",
    "tools/pgd_decrypt.py": "Python reference PGD decryptor; same unresolved distribution question as src/rt/pgd.c.",
    "tools/pgd_e2e_harness.c": "PGD end-to-end harness; exercises the excluded implementation.",
    "tools/pgd_test_keys.py": "Synthetic PGD constants. The values are provably invented, but the file exists only to drive the excluded implementation.",
    "tools/test_pgd_c.py": "Test for the excluded PGD C port.",
    "tools/test_pgd_decrypt.py": "Test for the excluded PGD Python reference.",
    "tools/test_pgd_hardening.py": "Test for the excluded PGD implementation.",
    "tools/test_pgd_malformed.py": "Test for the excluded PGD implementation."
  },
  "notes": [
    "Exclusion is evaluated before inclusion and always wins.",
    "A path that appears in no list resolves to default_disposition REJECT.",
    "Adding a path to include_paths is a publication decision and must be reviewed as one.",
    "Excluded status is gated on qualified review, not on the administrative state of any issue tracker."
  ],
