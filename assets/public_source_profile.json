  "name": "public-safe-v1",
  "profile_version": "2.0.0",
  "min_tool_version": "0.4.0",
  "description": "Canonical publication-eligibility policy. Authoritative statement of which tracked paths may appear in a public candidate tree. Publication eligibility is decided by explicit enumeration only; unknown paths are rejected.",
