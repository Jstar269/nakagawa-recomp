{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jstar269/nakagawa-recomp/raw/main/assets/flight_recorder_schema.json",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later",
  "title": "Nakagawa Recomp Flight Recorder Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "build", "recorder", "terminal", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cpu_state_abi"],
      "properties": {
        "name": {"const": "nakagawa-recomp"},
        "cpu_state_abi": {"const": 2}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "compiled_date", "compiled_time", "pointer_bits"],
      "properties": {
        "compiler": {"enum": ["gcc", "clang", "other"]},
        "compiled_date": {"type": "string", "pattern": "^[A-Z][a-z]{2} [ 0-9][0-9] [0-9]{4}$"},
        "compiled_time": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"},
        "pointer_bits": {"enum": [32, 64]}
      }
    },
    "recorder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled_classes", "limit", "recorded", "dropped", "triggers"],
      "properties": {
        "enabled_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["hle", "unsupported", "sched", "prx", "fault", "fatal"]}
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 4096},
        "recorded": {"type": "integer", "minimum": 0},
        "dropped": {"type": "integer", "minimum": 0},
        "triggers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_fatal", "first_unsupported_nid", "fired"],
          "properties": {
            "first_fatal": {"type": "boolean"},
            "first_unsupported_nid": {"type": "boolean"},
            "fired": {"type": "integer", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "sequence", "kind", "arg0"],
      "properties": {
        "reason": {"enum": ["running", "exit", "fatal", "unsupported-nid"]},
        "sequence": {"type": "integer", "minimum": 0},
        "kind": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "arg0": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "events": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "sequence", "class", "kind", "arg0", "arg1", "arg2", "arg3"],
        "properties": {
          "schema_version": {"const": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "class": {"enum": ["hle", "unsupported", "sched", "prx", "fault", "fatal"]},
          "kind": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "arg0": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "arg1": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "arg2": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "arg3": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        }
      }
    }
  }
}
