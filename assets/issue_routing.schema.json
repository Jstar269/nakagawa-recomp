{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jstar269/nakagawa-recomp/raw/main/assets/issue_routing.schema.json",
  "title": "Nakagawa Recomp Issue Routing Metadata v1",
  "description": "Checked-in public issue readiness and dependency metadata. GitHub issue state and oracle links are validated when the matrix is generated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "routing_source": {"type": "string", "maxLength": 512},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "primary_state"],
      "properties": {
        "issue": {"type": "integer", "minimum": 1},
        "primary_state": {
          "enum": [
            "legal",
            "upstream",
            "environment",
            "private_route",
            "implementation",
            "local_acceptance",
            "hardware",
            "future_work"
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "oracle_groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"}
        },
        "hardware_test_id": {"type": "string", "minLength": 1},
        "local_test_command": {"type": "string", "minLength": 1},
        "note": {"type": "string", "maxLength": 1024}
      }
    }
  }
}
