# =============================================================================
# Nakagawa Recomp .gitattributes
# Normalise line endings for text; protect binary assets from CRLF corruption.
# Without binary marking, git may rewrite .dll/.bin/.iso/.elf on checkout and
# silently corrupt the loader/runtime or any accidentally-committed game data.
# =============================================================================

# Source / text: enforce LF on checkout and in the repo.
*                 text=auto eol=lf
*.c               text eol=lf
*.h               text eol=lf
*.cpp             text eol=lf
*.hpp             text eol=lf
*.py              text eol=lf
*.ps1             text eol=lf
*.md              text eol=lf
*.toml            text eol=lf
*.json            text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
Makefile          text eol=lf

# Derived public controls remain tracked and audited, but are generated data
# rather than hand-authored source. Keep language statistics from presenting
# their mechanical JSON churn as implementation code; leave review diffs
# visible because these controls are audited bytes.
/PUBLIC_EXPORT.json                         linguist-generated=true
/assets/public_provenance_ledger.json      linguist-generated=true
/assets/public_source_profile.json         linguist-generated=true

# Binaries: never touch line endings.
*.dll             binary
*.exe             binary
*.so              binary
*.bin             binary
*.elf             binary
*.iso             binary
*.cso             binary
*.chd             binary
*.dax             binary
*.jso             binary
*.PBP             binary
*.pbp             binary
*.prx             binary
*.PRX             binary
*.VAG             binary
*.vag             binary
*.AT3             binary
*.at3             binary
*.pgf             binary
*.ppm             binary
*.png             binary
*.jpg             binary
*.jpeg            binary
*.webp            binary
*.ogg             binary
*.dat             binary
